    "bIgnoreFeelings": true,
    "strLedgerDef": "ENCHeatGalConFinePublicDisorder",
    "aSocialNew": []
  },
  {
    "strName": "ENCHeatGalConFineDebtEnd",
    "strTitle": "Просить о штрафе (В рассрочку)",
    "strDesc": "Похоже, они хотят, чтобы вы нарушали правила, так им проще глубже загнать вас в долговую яму с процентами.\n\nВы подписываете кипы бумаг в тесных наручниках.\n\nЭто тюремный срок иного рода. Ещё один груз на вашей шее.\n\nДобавлен новый долг на $15,000 с выплатами каждую смену.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatGalConFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
