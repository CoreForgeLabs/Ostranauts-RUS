[
  {
    "strName": "ENCHeatGalConBustedStart",
    "strTitle": "Задержан",
    "strDesc": "Вас доставляют к магистрату GalCon для вынесения приговора, оставив ваш корабль и снаряжение позади.\n\nНа слушании вы можете умолять лишь о штрафе — $15,000 с выплатой сразу или в рассрочку — иначе вас отправят в тюрьму Port Mojave на год или три каторжных работ.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatGalConFineEnd",
      "ENCHeatGalConFineDebtEnd",
      "ENCHeatGalConPrisonStart"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",
    "strImage": "encounters/ENCImprisoned",
