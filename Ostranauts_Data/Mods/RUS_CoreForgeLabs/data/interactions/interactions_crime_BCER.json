  },
  {
    "strName": "ENCHeatGalConFineEnd",
    "strTitle": "Просить о штрафе (Единовременно)",
    "strDesc": "Похоже, они хотят, чтобы вы нарушали правила, так им проще вытягивать из вас новые штрафы.\n\nВы подписываете кипы бумаг в тесных наручниках.\n\nЭто тюремный срок иного рода. Ещё один груз на вашей шее.\n\nДобавлен новый штраф на $15,000.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatGalConFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",
    "strImage": "encounters/EncFirstUndockFees",
    "nLogging": 0,
    "bPause": true,
